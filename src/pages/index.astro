---
import { env } from "cloudflare:workers";
import Catalogo from "../components/catalogo.astro";
import Preparando from "../components/preparando.astro";
import PrimerArranque from "../components/primer-arranque.astro";
import { textos } from "../i18n";
import Base from "../layouts/base.astro";
import { datosInicio } from "../lib/paginas";

const t = textos(Astro.locals.idioma).tienda;
const datos = await datosInicio(env, Astro.url.origin, Astro.locals.idioma);
---

{
  datos.estado === "sin-reclamar" ? (
    <PrimerArranque />
  ) : datos.estado === "configurando" ? (
    <Preparando />
  ) : (
    <Base titulo={datos.nombre} descripcion={t.productosDe(datos.nombre)}>
      <script slot="head" type="application/ld+json" is:inline set:html={datos.jsonLd} />
      <Catalogo datos={datos} />
    </Base>
  )
}
