---
import { texts } from "../i18n";
import type { ProductView } from "../lib/pages";
import { MAX_QUANTITY } from "../scripts/cart";

/**
 * One catalog card: square photo (or an empty square), name and price, with "Desde" as a label of its own.
 * Below, a quantity and "Agregar" (catalog script); a product with options links to its page to choose them.
 */
interface Props {
  product: ProductView;
}
const { product: p } = Astro.props;
const all = texts(Astro.locals.language ?? "es");
const t = all.store;
---

<li class="product">
  <a class="product__link" href={`/p/${p.slug}`}>
    <span class="product__photo">
      {
        p.images[0] && (
          <img class="product__img" src={p.images[0].url} alt={p.name} width="320" height="320" loading="lazy" />
        )
      }
      {/* The second photo shows on hover (pointer devices only); decorative, the first one carries the alt. */}
      {
        p.images[1] && (
          <img class="product__img product__img--alt" src={p.images[1].url} alt="" width="320" height="320" loading="lazy" />
        )
      }
    </span>
    <strong class="product__name">{p.name}</strong>
    <span class="product__price">
      {p.priceFrom && <span class="price__from">{t.from}</span>}
      {p.priceLabel}
    </span>
  </a>
  {/* Controls stay outside the link: a button inside <a> is invalid HTML. */}
  {
    p.options.length > 0 ? (
      <a class="button secondary product__choose" href={`/p/${p.slug}`}>{t.choose}</a>
    ) : (
      <div class="product__buy" data-buy>
        <div class="stepper product__stepper">
          <button type="button" class="stepper__button" data-step="-1" aria-label={all.cart.oneLess}>
            −
          </button>
          <input
            class="stepper__input"
            type="number"
            min="1"
            max={MAX_QUANTITY}
            value="1"
            inputmode="numeric"
            aria-label={t.quantityOf(p.name)}
            data-quantity
          />
          <button type="button" class="stepper__button" data-step="1" aria-label={all.cart.oneMore}>
            +
          </button>
        </div>
        <button
          type="button"
          class="product__add"
          data-add-to-cart
          data-product-id={p.id}
          data-slug={p.slug}
          data-name={p.name}
          data-amount={p.price.amount}
          data-currency={p.price.currency}
          data-image={p.images[0]?.url ?? ""}
          data-added-text={all.cart.addedShort}
        >
          <svg class="product-page__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12l5 5L20 7" />
          </svg>
          <span data-add-text>{t.addShort}</span>
        </button>
      </div>
    )
  }
</li>
